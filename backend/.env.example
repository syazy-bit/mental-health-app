# Copy to .env and fill in real values. Never commit .env.
# PostgreSQL connection string (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mental_health

# Runtime environment: development | test | production
ENVIRONMENT=development

# Comma-free JSON list of allowed browser origins (frontend).
CORS_ORIGINS=["http://localhost:3000"]

# M6: AI chat provider selection: ollama (default) | fallback
AI_PROVIDER=ollama

# M6: Ollama local configuration (used when AI_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# M8: Admin Authentication Configuration
# Generate a strong random secret for production: openssl rand -hex 32
# The JWT signing/verification algorithm is hard-pinned to HS256 and is NOT
# configurable (see app/core/config.py: ADMIN_AUTH_ALGORITHM).
ADMIN_AUTH_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_SECRET
ADMIN_AUTH_TOKEN_EXPIRE_MINUTES=1440

# M8: Admin login throttling (in-memory, per-process; see app/api/rate_limit.py).
# ADMIN_LOGIN_MAX_FAILURES=5
# ADMIN_LOGIN_IP_MAX_FAILURES=20
# ADMIN_LOGIN_WINDOW_SECONDS=900
# ADMIN_LOGIN_LOCKOUT_SECONDS=900