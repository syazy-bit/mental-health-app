# Copy to .env (or backend/.env) and fill in real values. Never commit .env files.

# Backend ------------------------------------------------------------
# PostgreSQL connection string (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mental_health
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Frontend -----------------------------------------------------------
# Base URL of the FastAPI backend, used by the Next.js client.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000