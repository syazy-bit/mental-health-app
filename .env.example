# Copy to .env (or backend/.env) and fill in real values. Never commit .env files.

# Backend ------------------------------------------------------------
# PostgreSQL connection string (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mental_health
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# M8: Admin authentication (JWT). Use a strong random secret in production:
# openssl rand -hex 32
ADMIN_AUTH_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_SECRET
ADMIN_AUTH_ALGORITHM=HS256
ADMIN_AUTH_TOKEN_EXPIRE_MINUTES=1440

# Frontend -----------------------------------------------------------
# Base URL of the FastAPI backend, used by the Next.js client.
# NEXT_PUBLIC_API_URL=http://localhost:8000